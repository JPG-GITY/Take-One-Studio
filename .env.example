# Media Velocity Engine - ByteDance POC Configuration
# Copy this file to .env and fill in your actual credentials:
#   cp .env.example .env

# ============ BytePlus / Volcano Engine Configuration ============
# Your BytePlus API key (from console.byteplus.com or ark.byteplus.com)
BYTEPLUS_API_KEY=your-byteplus-api-key-here

# Seedream-specific key if separate; falls back to BYTEPLUS_API_KEY if not set
SEEDDREAM4_API_KEY=your-byteplus-api-key-here

# BytePlus Ark API endpoint
# Southeast Asia: https://ark.ap-southeast.bytepluses.com/api/v3
# China region:   https://ark.cn-beijing.volces.com/api/v3
BYTEPLUS_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3

# ============ Anthropic (Claude — the writing / QC "brain") ============
# REQUIRED — not optional. Breakdown, prompt-writing, face blocks and the QC
# fallback all fail without it. Get it from console.anthropic.com.
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# ============ Model IDs (all optional — defaults shown) ============
# Swap in a new release (e.g. Seedream 5 Pro, Seedance 2.5) here — no code change.
# BEFORE switching, re-verify: (a) Seedream outputs stay Seedance-trusted (the
# identity anchor depends on the watermark), (b) the Seedance param matrix — 4k,
# seed/camera_fixed support differ per version.
#SEEDREAM_MODEL=seedream-5-0-260128
#SEEDANCE_MODEL=dreamina-seedance-2-0-260128
#DEEPSEEK_MODEL=deepseek-v4-flash-260425
#CLAUDE_AGENT_MODEL=claude-sonnet-4-6
#BYTEPLUS_VISION_MODEL=seed-2-0-pro-260328
#BYTEPLUS_EMBED_MODEL=skylark-embedding-vision-251215

# QC gate verdicts run on Seed 2.0 Pro (BytePlus) by default so they DON'T spend
# Anthropic credits — Claude stays reserved for the "brain" (breakdown, prompts,
# face blocks). Vision is already BytePlus, so QC is 100% BytePlus. Claude is an
# automatic fallback if seed is missing/errors. Flip to `claude` to revert.
#QC_BACKEND=seed
#QC_MODEL=seed-2-0-pro-260328

# The production BREAKDOWN runs on Claude by default (it's a "brain" writing task).
# Set to `seed` to route it to Seed 2.0 Pro (BytePlus billing) with a Claude
# fallback. This is INDEPENDENT of QC_BACKEND above — QC verdicts have their own
# flag, so QC can stay on Seed while the breakdown runs on Claude.
#BREAKDOWN_BACKEND=claude

# ============ BytePlus Voice / Text-to-Speech (Seed TTS 2.0) ============
# Separate API key for the Voice service (voice.ap-southeast-1.bytepluses.com).
# Get it from the BytePlus Voice console. Used by the Studio "AI Voice" mode.
SEED_TTS_API_KEY=your-byteplus-voice-api-key-here
# Resource id selects the model version (seed-tts-2.0). Override only if needed.
SEED_TTS_RESOURCE_ID=seed-tts-2.0

# ============ BytePlus Seed Audio 1.0 (voice cloning per actor) ============
# REST TTS on the SAME voice host, model seed-audio-1.0. Activate "Seed-Audio 1.0"
# in the BytePlus Voice console, then paste its API key here. If left blank the
# code falls back to SEED_TTS_API_KEY. Powers consistent cloned voices per character.
SEED_AUDIO_API_KEY=
SEED_AUDIO_MODEL=seed-audio-1.0
# Optional: override how a cloned line is prompted if the wrapper is read aloud.
# SEED_AUDIO_CLONE_TEMPLATE=Speak the following line in the voice of @Audio1: "{text}"

# ============ Cloudflare R2 (temp hosting for Seedance video references) ============
# Seedance requires reference_video to be a PUBLIC URL (it rejects base64). The
# Studio uploads a reference video to R2, hands Seedance the public URL, then
# deletes it once the task finishes. Only needed if you use video refs in
# multimodal video. Create an R2 bucket with public access (r2.dev or a custom
# domain) and an S3 API token.
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=your-bucket-name
# Public base URL for the bucket (e.g. https://pub-xxxx.r2.dev or a custom domain)
R2_PUBLIC_BASE_URL=https://pub-xxxx.r2.dev

# ============ BytePlus AI MediaKit (Studio "Upscale" — video enhancement) ============
# A VOD-family product with its OWN host and key: NOT the ModelArk key above, and the
# Ark CLI cannot list or create it. Create it in the AI MediaKit console (Settings →
# Create API key). Sent as `Authorization: Bearer`. Source clips are hosted on R2 for
# the task (the vendor only downloads public urls), so R2_* above must be set too.
# Price = output minutes × coefficient × $0.2066: a 10 s clip to 4K is $0.28 on
# standard and $2.75 on professional (byteplus_mediakit.py has the full table).
BYTEPLUS_MEDIAKIT_API_KEY=
# Only if BytePlus moves the service to another region (docs list ap-southeast-1 only).
#BYTEPLUS_MEDIAKIT_BASE_URL=https://mediakit.ap-southeast-1.bytepluses.com

# ============ Application Configuration ============
# Logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Phase-2 wardrobe variants (default 0 = off). When 1, the breakdown detects each
# character's outfits per scene and emits variant character assets; AG renders every
# variant from the base's approved sheet (Seedream Pro i2i), so only the clothes change.
WARDROBE_VARIANTS=0
